  "release_lines": {
    "revenue": [
      {
        "line": 26,
        "text": "Second quarter revenue was $11.5 billion, gross margin was 54%, operating income was $2.0 billion, net income was $2.3 billion and diluted earnings per share was $1.38."
      },
      {
        "line": 30,
        "text": "\u201cRevenue increased 50% year-over-year to a record $11.5 billion, driven by continued strength in our Data Center business, which represented 58% of company revenue in the quarter,\u201d said Jean Hu, AMD executive vice president, chief financial officer and treasurer."
      },
      {
        "line": 532,
        "text": "Total net revenue | $11,536 | $10,253 | $7,685 | $21,789 | $15,123"
      },
